#!/bin/bash
# Source: http://unix.stackexchange.com/a/24636/18876
# See also: dateutils.ddiff
set -o pipefail
shopt -qs extglob

: ${DATE:=date}

export DURATIONTOSECONDS_ACCEPT_NEGATIVE=t

hasCustomWhat=; [ -n "$DATEDIFF_WHAT" ] && hasCustomWhat=t
: ${DATEDIFF_COMMAND:=$(basename "$0")}
: ${DATEDIFF_WHAT:='the difference between two DATEs or TIMEs / the passed DATE or TIME and now'}
: ${DATEDIFF_SINGLE_INPUT_ARGS:='-f|--file FILE [-f ...]|DATE|TIME'}
: ${DATEDIFF_INPUT_ARGS:="(${DATEDIFF_SINGLE_INPUT_ARGS}) [DATE|TIME]"}
: ${DATEDIFF_ADDITIONAL_EXIT_STATUS:='    4	Invalid DATE(s) / TIME(s) passed.
    5	A FILE could not be read.
    99	Empty input; no DATE / TIME could be read.'}
readonly generalArgs='[-u|--utc|--universal] [-F|--field-separator FS]'
readonly availableOutputFormats='s[econd[s]]|m[inute[s]]|h[our[s]]|d[ay[s]]|w[eek[s]]|mo[nth[s]]|y[ear[s]]|g[eneration[s]]|original|epoch|empty|whole-units|smallest-unit|best-unit|largest-unit|precise|all|textform'
readonly precisionArgs='[--prefer-clock] [--long-units] [--precision|-p N|[U|Z][.N](w|d|h|m|s) | --precision-width|-P WIDTH] [-w|--width [+]WIDTH]'
readonly prefixSuffixArgs='[--prefix PREFIX [--prefix ...]] [--suffix SUFFIX [--suffix ...]]'
readonly timeslotParameters='s[econd]|m[inute]|h[our]|d[ay]|w[eek]|mo[nth]|y[ear]'
readonly newerOlderOptions='--newer|--older'
readonly comparisonOptions='-lt|-le|-eq|-ne|-ge|-gt'
readonly timeslotOptions='-w|--within|-W|--outside'
readonly comparisonInfluencingOptions='[-a|--absolute]'
readonly outputInfluencingOptions='[--short-units] [-A|--always-output|-S|--success-output] [-a|--absolute|[--output-positive|--output-inverted] [--no-direction]]'
getShortUsage()
{
    local -r newerOlderArgs="$newerOlderOptions [-]TIMESPAN|TIMESLOT"
    local -r timeslotArgs="$timeslotOptions TIMESLOT"
    local -r comparisonArgs="$comparisonOptions [-]TIMESPAN"
    case "$1" in
	'') printf %s "$generalArgs [-o|--output ${availableOutputFormats} ${precisionArgs}] $prefixSuffixArgs $outputInfluencingOptions [${newerOlderArgs} | ${comparisonArgs} | ${timeslotArgs}]";;
	newer-older-parameters)
	    local -r timespanFormat="$(durationToSeconds --get-short-usage format 2>/dev/null)"
	    printf %s "${timespanFormat}|${timeslotParameters}";;
	comparisons)
	    printf %s "${newerOlderArgs} | ${comparisonArgs} | ${timeslotArgs} ${comparisonInfluencingOptions}";;
	filter)
	    local fieldSeparatorArg='[-F|--field-separator FS]'; [ -n "${fieldSeparator+t}" ] && fieldSeparatorArg=''
	    printf %s "${fieldSeparatorArg}${fieldSeparatorArg:+ }${newerOlderArgs}|DATE|TIME | ${comparisonArgs}|DATE|TIME | ${timeslotArgs} ${comparisonInfluencingOptions}";;
	output)
	    printf %s "-o|--output ${availableOutputFormats} ${precisionArgs}] $prefixSuffixArgs $outputInfluencingOptions";;
	*)  echo "ERROR: Unknown short usage topic \"$1\"!" >&2; return 2;;
    esac
}
getLongUsage()
{
    local topic="$1"; shift
    local what="$1"; shift
    local -r timespanFormat="$(durationToSeconds --get-short-usage format 2>/dev/null)"
    case "$topic" in
	comparisons)
	    cat <<HELPTEXT
    ${newerOlderOptions} [-]TIMESPAN|TIMESLOT | $comparisonOptions $timespanFormat | $timeslotOptions $timeslotParameters ${comparisonInfluencingOptions}
	    		Only print those ${what:-lines} that match the
			TIMESPAN|TIMESLOT comparison.
HELPTEXT
	    ;;
	filter)
	    cat <<HELPTEXT
    ${newerOlderOptions} [-]TIMESPAN|TIMESLOT|DATE|TIME | $comparisonOptions ${timespanFormat}|DATE|TIME | $timeslotOptions $timeslotParameters ${comparisonInfluencingOptions}
	    		Only print those ${what:-lines} that match the
			TIMESPAN|TIMESLOT|DATE|TIME comparison.
HELPTEXT
	    ;;
	*)  echo "ERROR: Unknown long usage topic \"$1\"!" >&2; return 2;;
    esac
}
printShortUsage()
{
    printf 'Usage: [DATEDIFF_OUTPUT_FORMAT=%s] %q %s\n' "$availableOutputFormats" "$DATEDIFF_COMMAND" "$generalArgs [-?|-h|--help] ..."
    echo
    cat <<HELPDESCRIPTION
Calculate ${DATEDIFF_WHAT}, and print it in flexible units depending on the magnitude of the difference.
HELPDESCRIPTION
    echo
    printf 'Usage: %q %s\n' "$DATEDIFF_COMMAND" "... [-o|--output ${availableOutputFormats} ${precisionArgs}] $prefixSuffixArgs $outputInfluencingOptions $DATEDIFF_INPUT_ARGS"
    echo
    if [ ! "$hasCustomWhat" ]; then
	cat <<HELPDESCRIPTION
Print the passed difference in seconds or days in flexible units depending on
the magnitude of the difference.
HELPDESCRIPTION
	echo
	printf 'Usage: %q %s\n' "$DATEDIFF_COMMAND" "... [-o|--output ${availableOutputFormats} ${precisionArgs}] $prefixSuffixArgs -s|--seconds|-d|--days NUM $outputInfluencingOptions"
	echo
    fi
    local timespanFormat="$(durationToSeconds --get-short-usage format 2>/dev/null)"
    cat <<HELPDESCRIPTION
Test whether ${DATEDIFF_WHAT} is greater / smaller than TIMESPAN.
Can be combined with -o|--output to print the actual difference [if the test
fails, or succeeds with -S|--success-output, or forced with -A|--always-output].
Note: $comparisonOptions are purely mathematical comparisons with the
difference of DATE|TIME to now / the second passed DATE|TIME to the first.
$newerOlderOptions instead are (signed) age comparisons; future dates / dates where
the second passed DATE|TIME is greater than the first are always newer (unless
-TIMESPAN, which asserts that it must be at least TIMESPAN in the future) and
never older. However, for a comparison against DATE|TIME, --newer is exactly the
same as -gt.
This is different from a comparison with --absolute, which would treat
(greater / smaller) differences the same regardless of being in the past or
future.
TIMESPAN can be ${timespanFormat}.
HELPDESCRIPTION
    echo
    printf 'Usage: %q %s\n' "$DATEDIFF_COMMAND" "... $newerOlderOptions [-]TIMESPAN|TIMESLOT $DATEDIFF_INPUT_ARGS"
    printf 'Usage: %q %s\n' "$DATEDIFF_COMMAND" "... $comparisonOptions [-]TIMESPAN $DATEDIFF_INPUT_ARGS"
    printf 'Usage: %q %s\n' "$DATEDIFF_COMMAND" "... $newerOlderOptions [-]TIMESPAN|TIMESLOT|DATE|TIME $DATEDIFF_SINGLE_INPUT_ARGS"
    printf 'Usage: %q %s\n' "$DATEDIFF_COMMAND" "... $comparisonOptions [-]TIMESPAN|DATE|TIME $DATEDIFF_SINGLE_INPUT_ARGS"
    echo
    cat <<HELPDESCRIPTION
Test whether ${DATEDIFF_WHAT} falls inside / outside TIMESLOT.
Use $newerOlderOptions instead of $timeslotOptions if you want future dates
/ dates where the second passed DATE|TIME is greater than the first to always
succeed the comparision; i.e. if you only care about falling outside the
timeslot in the past.
TIMESLOT can be one of ${timeslotParameters}.
HELPDESCRIPTION
    echo
    printf 'Usage: %q %s\n' "$DATEDIFF_COMMAND" "... $timeslotOptions TIMESLOT $DATEDIFF_INPUT_ARGS"
}
printUsage()
{
    # This is the short help when launched with no or incorrect arguments.
    # It is printed to stderr to avoid accidental processing.
    printShortUsage "$1" >&2
    printf >&2 '\nTry %q --help for more information.\n' "$DATEDIFF_COMMAND"
}
printLongUsage()
{
    # This is the long "man page" when launched with the help argument.
    # It is printed to stdout to allow paging with 'more'.
    printShortUsage "$1"
    echo
    cat <<HELPTEXT
For example, --within day would yield false despite an actual age difference of
only seconds if one is before midnight and the other shortly after midnight,
whereas "-le 1d" would yield true as long as the actual difference is within
86400 seconds.
    --utc|--universal|-u
			Use Coordinated Universal Time (UTC) instead of local
			time for all dates.
    --absolute|-a	Print / compare against the absolute (positive)
			difference, i.e. ignore which of the two dates is
			earlier / the sign of the passed difference.
    --always-output|-A	Normally, when a comparison is made and succeeds, the
			difference is not printed; with this flag, it is always
			printed.
    --success-output|-S	Normally, when a comparison is made and succeeds, the
			difference is not printed; this flag inverts that, so
			dates that pass the comparison have the difference
			printed, and those that don't are suppressed.
    --short-units	Use "2m" instead of "2 minutes".
    --output-positive	Omit a negative sign on negative differences (in the
			output, but unlike --absolute not in the comparison).
			Keeps "in / ago".
    --output-inverted	Invert the sign of the difference (in the output), so
			(when comparing to now) past dates are positive and
			future dates are negative. Does not affect "in / ago".
    --no-direction	No "in / ago" when comparing to now / passed
			differences.
    --prefix PREFIX	Put PREFIX before the output.
    --suffix SUFFIX	Append SUFFIX at the end.
    --file|-f FILE	Read DATE(s) / TIME(s) (one per line, possibly followed
			by tab-separated other content, which is taken over to
			the output; empty DATE / TIME is tolerated) from FILE.
			These are then each compared to now / (as the second
			date to) the passed DATE / TIME (being the first).
    --field-separator|-F FS
			Use FS for splitting the leading DATE / TIME off of
			following content (instead of the default tab
			character). Unlike AWK, does not support a regular
			expression here.
$DATEDIFF_ADDITIONAL_OPTIONS
EXIT STATUS:
    0	Complete success.
    	With --filter: At least one date passed the comparison.
    1	The comparison failed; at least one DATE / TIME did not pass it.
    	With --filter: No date passed the comparison.
    2	Bad invocation, wrong or missing command-line arguments.
$DATEDIFF_ADDITIONAL_EXIT_STATUS
HELPTEXT
}

ensureSingleDifference()
{
    [ "$hasDifference" ] || return 0
    echo >&2 'ERROR: Cannot combine -s|--seconds with -d|--days.'
    echo >&2
    printUsage "$0" >&2
    exit 2
}

getDate()
{
    if [ "$timeformat" = '%s' ] && [[ "${1:?}" =~ ^@[0-9]+$ ]]; then
	printf %d "${1#@}"  # Optimization if the passed date is already in seconds since the epoch.
    else
	"$DATE" "${dateArgs[@]}" --date="${1:?}" "+${timeformat:?}"
    fi
}

timespan=
spanCompareOp=
compareEpoch=
epochCompareOp=
parseTimespan()
{
    local potentialCompareOp="${1:?}"; shift
    if timespan=$(durationToSeconds -- "${1:?}"); then
	spanCompareOp="$potentialCompareOp"
    elif compareEpoch=$(getDate "${1:?}" 2>/dev/null); then
	epochCompareOp="$potentialCompareOp"
    else
	return 1
    fi
}
timeformat='%s'
parseTimeslot()
{
    case "${1:?}" in
	s?(econd))			    timeformat='%s';;
	m?(inute))			    timeformat='%F_%H:%M';;
	h?(our))			    timeformat='%F_%H';;
	d?(ay))				    timeformat='%F';;
	w?(eek))			    timeformat='%G_%V';;
	mo?(nth))			    timeformat='%Y_%m';;
	y?(ear))			    timeformat='%Y';;
	*)				    return 1;;
    esac
}
isNegated=
formatCompareOp=
combinedCompareOp='-eq'
parseAgeOrTimeslot()
{
    local potentialCompareOp="${1:?}"; shift
    local potentialCombinedCompareOp="${1:?}"; shift

    if parseTimeslot "${1:?}"; then
	spanCompareOp='-ge'
	timespan=0
	formatCompareOp='='
	combinedCompareOp="$potentialCombinedCompareOp"
    elif timespan=$(durationToSeconds -- "${1:?}"); then
	spanCompareOp="$potentialCompareOp"
	let timespan=-timespan
    elif compareEpoch="$(getDate "${1:?}" 2>/dev/null)"; then
	epochCompareOp="$potentialCompareOp"
    else
	return 1
    fi
    isNegated=t
}

typeset -a dateArgs=()
isAbsolute=
outputSign=
isDirection=t
isShortUnits=
hasDifference=
secondsDiff=
daysDiff=
outputFormat="$DATEDIFF_OUTPUT_FORMAT"
isAlwaysOutput=
isSuccessOutput=
typeset -a secondsToDurationArgs=()
prefix=
suffix=
typeset -a filespecs=()
dateArgOffset=1
unset fieldSeparator
isFilter=
statusHandler=handleNormalStatus
option() { :; }
parameter() { :; }
endOfOptionsAndParameters() { :; }
noUnderstand() { :; }
typeset -A understandsSubtopics=()
isUnderstandSubtopic() {
    [ $# -gt 0 -a ${#understandsSubtopics[@]} -gt 0 ] || return 0
    local subtopic; for subtopic
    do
	[ "${understandsSubtopics["$subtopic"]}" ] && return 0
    done
    return 1
}
while [ $# -ne 0 ]
do
    case "$1" in
	--help|-h|-\?)	shift; printLongUsage "$0"; exit 0;;
	--get-short-usage)
			shift; getShortUsage "$@"; exit $?;;
	--get-long-usage)
			shift; getLongUsage "$@"; exit $?;;
	--print-usage)	shift; printUsage "$0"; exit 2;;
	--understand-for)
			shift; understandsSubtopics["$1"]=t; shift;;
	--understands)	shift
			option() { isUnderstandSubtopic "$@" || exit 1; printf 1; exit 0; }
			parameter() { isUnderstandSubtopic "$@" || exit 1; printf 2; exit 0; }
			endOfOptionsAndParameters() { exit 99; }
			noUnderstand() { exit 1; }
			;;

	--universal|--utc|-u)
			dateArgs+=("$1"); shift; option;;
	--absolute|-a)	shift; isAbsolute=t; option comparisons;;
	--always-output|-A)
			shift; isAlwaysOutput=t; option;;
	--success-output|-S)
			shift; isSuccessOutput=t; option;;
	--short-units)	shift; isShortUnits=t; option;;
	--output-positive)
			shift; outputSign=positive; option;;
	--output-inverted)
			shift; outputSign=inverted; option;;
	--no-direction)	shift; isDirection=; option;;
	--output|-o)	shift; outputFormat="${1:?}"; shift; parameter;;
	--prefer-clock|--long-units)
			secondsToDurationArgs+=("$1"); shift; option;;
	--precision|-p|--precision-width|-P|--width|-w)
			secondsToDurationArgs+=("$1" "${2:?}"); shift; shift; parameter;;
	--prefix)	shift; prefix+="${1?}"; shift; parameter;;
	--suffix)	shift; suffix+="${1?}"; shift; parameter;;

	--seconds|-s)	shift; ensureSingleDifference; secondsDiff="${1:?}"; shift; hasDifference=t; parameter;;
	--days|-d)	shift; ensureSingleDifference; daysDiff="${1:?}"; shift; hasDifference=t; parameter;;

	--newer)	shift; parseAgeOrTimeslot -gt -eq "${1:?}" || { printf >&2 'ERROR: Illegal TIMESPAN or TIMESLOT: %s\n\n' "$1"; printUsage "$0" >&2; exit 2; }; shift; parameter comparisons filter;;
	--older)	shift; parseAgeOrTimeslot -lt -ne "${1:?}" || { printf >&2 'ERROR: Illegal TIMESPAN or TIMESLOT: %s\n\n' "$1"; printUsage "$0" >&2; exit 2; }; shift; parameter comparisons filter;;
	-lt|-le|-eq|-ne|-ge|-gt)
			parseTimespan "$1" "${2:?}" || { printf >&2 'ERROR: Illegal TIMESPAN: %s\n\n' "$2"; printUsage "$0" >&2; exit 2; }; shift; shift; parameter comparisons filter;;
	--within|-w)	shift; parseTimeslot "${1:?}" || { printf >&2 'ERROR: Invalid TIMESLOT: "%s".\n\n' "$1"; printUsage "$0" >&2; exit 2; }; formatCompareOp='='; shift; parameter comparisons filter;;
	--outside|-W)	shift; parseTimeslot "${1:?}" || { printf >&2 'ERROR: Invalid TIMESLOT: "%s".\n\n' "$1"; printUsage "$0" >&2; exit 2; }; formatCompareOp='!='; shift; parameter comparisons filter;;

	--file|-f)	shift; filespecs+=("${1:?}"); shift; dateArgOffset=0; parameter;;
	--file=*)	filespecs+=("${1#--file=}"); shift; dateArgOffset=0; option;;
	--field-separator|-F)
			shift; fieldSeparator="${1:?}"; shift; parameter filter;;

	--filter)	shift; dateArgOffset=0; isSuccessOutput=t; outputFormat=empty; isFilter=t; statusHandler=handleFilterStatus; option;;

	--)		endOfOptionsAndParameters; [ "$hasDifference" ] || shift; break;;
	-*)		noUnderstand; { echo "ERROR: Unknown option \"$1\"!"; echo; printUsage "$0"; } >&2; exit 2;;
	*)		endOfOptionsAndParameters; break;;
    esac
done
if [ "$hasDifference" ] && [ ${#filespecs[@]} -gt 0 ]; then
    echo 'ERROR: Cannot combine -s|--seconds|-d|--days with -f|--file.'
    echo
    printUsage "$0"
    exit 2
elif [ "$isNegated" ] && [ "$isAbsolute" ]; then
    echo "ERROR: Cannot combine -a|--absolute with $newerOlderOptions; use $comparisonOptions / $timeslotOptions instead."
    echo
    printUsage "$0"
    exit 2
elif [ "$isAlwaysOutput" ] && [ "$isSuccessOutput" ]; then
    echo 'ERROR: Cannot combine -A|--always-output with -S|--success-output.'
    echo
    printUsage "$0"
    exit 2
elif [ "$isFilter" ] && [ -z "$spanCompareOp" ] && [ -z "$epochCompareOp" ] && [ -z "$formatCompareOp" ]; then
    printf 'ERROR: Comparison option required: %s\n' "$(getShortUsage comparisons)"
    echo
    printUsage "$0"
    exit 2
elif [ -n "$epochCompareOp" ] && [ $# -gt 1 ]; then
    echo 'ERROR: Only one DATE|TIME can be compared against another DATE|TIME. Date differences can only be compared against TIMESPAN or TIMESLOT.'
    echo
    printUsage "$0"
    exit 2
fi >&2
if [ -n "$spanCompareOp" ] || [ -n "$epochCompareOp" ] || [ -n "$formatCompareOp" ]; then
    if [ "$hasDifference" ]; then
	echo "ERROR: Cannot combine -s|--seconds|-d|--days with ${newerOlderOptions}|${comparisonOptions}|${timeslotOptions}."
	echo
	printUsage "$0"
	exit 2
    elif (($# < dateArgOffset || $# > dateArgOffset + 1)); then
	printUsage "$0"
	exit 2
    fi
elif [ -n "$secondsDiff" ]; then
    if [ $# -gt 0 ]; then
	printUsage "$0"
	exit 2
    fi
elif [ -n "$daysDiff" ]; then
    if [ $# -gt 0 ]; then
	printUsage "$0"
	exit 2
    fi
elif (($# < dateArgOffset || $# > dateArgOffset + 1)); then
    printUsage "$0"
    exit 2
fi >&2

: ${fieldSeparator:=$'\t'}
[ "$isFilter" ] && [ ${#filespecs[@]} -eq 0 ] && filespecs=(-)
[ -n "$NOW" ] \
    && getNow() { printf %s "$NOW"; } \
    || getNow() { printf '%(%s)T' -1; }

parseDates()
{
    if [ $# -eq 1 ]; then
	d1=$(getDate "@$(getNow)") \
	    && d2=$(getDate "$1")
    else
	d1=$(getDate "$1") \
	    && d2=$(getDate "$2")
    fi || return 4
}

isOutput()
{
    { [ -z "$spanCompareOp" ] && [ -z "$epochCompareOp" ] && [ -z "$formatCompareOp" ]; } || [ -n "$outputFormat" ]
}

addDiffUnit()
{
    local diff="${1?}"; shift
    local shortUnit="${1:?}"; shift
    local unit="${1:?}"; shift

    [ -n "$diff" ] || return
    [ "$diff" = 0 -a "$unit" != second ] && return	# Skip values that are zero, but keep at least "0 seconds" as the pathological corner case.
    local flooredDiff="${diff%.*}"; flooredDiff=${flooredDiff#-}
    [ ${#flooredDiff} -gt 4 ] && return	# Skip values that are too large (>9999).

    if [ "$isShortUnits" ]; then
	diffInUnits+=("${diff}${shortUnit}")
    else
	local unitPlural='s'
	[ "${diff#-}" = '1' ] && unitPlural=
	diffInUnits+=("$diff ${unit}${unitPlural}")
    fi
}
calculateUnit()
{
    local diff="${1?}"; shift
    local shortUnit="${1:?}"; shift
    local unit="${1:?}"; shift
    local divisor=$1; shift
    local unitDiff=$(divround $((100 * diff / divisor)))
    [ -n "$diff" ] || return
    addDiffUnit "$unitDiff" "$shortUnit" "$unit"
}
printCalculated()
{
    local diff=$1; shift
    local divisor=$1; shift
    local unitDiff=$(divround $((100 * diff / divisor)))
    local flooredDiff="${unitDiff%.*}"
    printf '%s%d%s%s\n' "$prefix" $flooredDiff "$suffix" "$addendum"
}
printOriginal()
{
    printf '%s%s%s%s\n' "$prefix" "${1?}" "$suffix" "$addendum"
}
printSingleUnit()
{
    printf '%s%d%s%s\n' "$prefix" "${1:?}" "$suffix" "$addendum"
}
printOne()
{
    printf '%s%s%s\n' "$prefixAndDirectionPrefix" "${1:?}" "$suffixAndDirectionSuffix"
}

getPreciseDiff()
{
    local sigil=''
    if [ -n "$secondsDiff" ]; then
	if [ $secondsDiff -lt 0 ]; then
	    sigil='-'
	    secondsDiff=$((-secondsDiff))
	fi
    elif [ -n "$daysDiff" ]; then
	if [ $daysDiff -lt 0 ]; then
	    sigil='-'
	    daysDiff=$((-daysDiff))
	fi
	secondsDiff=$((daysDiff * 86400))
    else
	return 0
    fi

    duration="$(secondsToDuration "${secondsToDurationArgs[@]}" "$secondsDiff")" || return 3
    printf %s%s "$sigil" "$duration"
}

diffOneDate()
{
    local directionPrefix=
    local directionSuffix=
    unset sigil
    local preciseDiff=
    typeset -a diffInUnits=()
    local status=0
    if [ -n "$spanCompareOp" ] || [ -n "$epochCompareOp" ] || [ -n "$formatCompareOp" ]; then
	local secondsDiff=
	parseDates "$@" || return $?
	{
	    [ -n "$formatCompareOp" ] \
		&& [ "$d1" $formatCompareOp "$d2" ]
	} || {
		[ -n "$spanCompareOp" ] && {
		    [ "$timeformat" = '%s' ] || timeformat='%s' parseDates "$@" || return $?
		    secondsDiff=$((d2 - d1))
		    [ "$isAbsolute" ] \
			&& secondsDiff=$((secondsDiff < 0 ? -secondsDiff : secondsDiff))
		    [ $secondsDiff ${spanCompareOp:?} $timespan ]
		}
	} || {
		[ -n "$epochCompareOp" ] && {
		    secondsDiff=$((d2 - compareEpoch))
		    [ "$isAbsolute" ] \
			&& secondsDiff=$((secondsDiff < 0 ? -secondsDiff : secondsDiff))
		    [ "$d2" $epochCompareOp "$compareEpoch" ]
		}
	}; status=$?
	if [ $status $combinedCompareOp 0 ];
	then
	    [ "$isAlwaysOutput" -o "$isSuccessOutput" ] && isOutput || return 0
	    status=0
	else
	    [ ! "$isSuccessOutput" ] && isOutput || return 1
	    status=1
	fi
	if [ -z "$secondsDiff" ]; then
	    timeformat='%s' parseDates "$@"
	    secondsDiff=$((d2 - d1))
	fi
    elif [ -n "$secondsDiff" ]; then
	:
    elif [ -n "$daysDiff" ]; then
	if [ "$isAbsolute" ]; then
	    daysDiff=$((daysDiff < 0 ? -daysDiff : daysDiff))
	elif [ "$isDirection" ]; then
	    if [ $daysDiff -eq 0 ]; then
		preciseDiff='today'
		diffInUnits+=("$preciseDiff")
	    elif [ $daysDiff -gt 0 ]; then
		sigil=''
		directionPrefix='in '
	    else
		daysDiff=$((-daysDiff))
		sigil='-'
		directionSuffix=' ago'
	    fi
	fi
	if [ $daysDiff -eq 0 ]; then
	    diffInUnits+=('0 days')
	    preciseDiff='0d'
	fi
    else
	parseDates "$@" || return $?
	local secondsDiff=$((d2 - d1))
	[ $# -eq 1 ] || isDirection=    # Disable direction if two dates are given.
    fi

    if [ -n "$secondsDiff" ]; then
	if [ "$isAbsolute" ]; then
	    secondsDiff=$((secondsDiff < 0 ? -secondsDiff : secondsDiff))
	elif [ "$isDirection" ]; then
	    if [ $secondsDiff -eq 0 ]; then
		preciseDiff='just now'
		diffInUnits+=("$preciseDiff")
	    elif [ $secondsDiff -gt 0 ]; then
		sigil=''
		directionPrefix='in '
	    else
		secondsDiff=$((-secondsDiff))
		sigil='-'
		directionSuffix=' ago'
	    fi
	elif [ $secondsDiff -eq 0 ]; then
	    preciseDiff='at a single point in time'
	    diffInUnits+=("$preciseDiff")
	fi
    fi
    if [ -z "$daysDiff" ]; then
	# Ignore $sigil here.
	[ $secondsDiff -lt 0 ] \
	    && local daysDiff=-$(( (-1 * secondsDiff + 43200) / 86400 )) \
	    || local daysDiff=$(( (secondsDiff + 43200) / 86400 ))
    fi
    if [ -z "$secondsDiff" ] && [ "$isDirection" ] && [ ! "$isAbsolute" ] && [ $daysDiff -eq 1 ]; then
	if [ "$sigil" = - ]; then
	    diffInUnits+=('yesterday' '1 day ago')
	    directionSuffix=''
	    local daysDiff=
	    preciseDiff='1d ago'
	else
	    diffInUnits+=('tomorrow' 'in 1 day')
	    directionPrefix=''
	    local daysDiff=
	    preciseDiff='in 1d'
	fi
    fi
    local prefixAndDirectionPrefix="${prefix}${directionPrefix}"
    local suffixAndDirectionSuffix="${directionSuffix}${suffix}${addendum}"

    case "$outputSign" in
	'')	    ;;
	positive)   [ -n "$secondsDiff" ] && [ $secondsDiff -lt 0 ] && secondsDiff=$((-secondsDiff))
		    [ -n "$daysDiff" ] && [ $daysDiff -lt 0 ] && daysDiff=$((-daysDiff))
		    unset sigil
		    ;;
	inverted)   if [ -n "${sigil+t}" ]; then
			[ "$sigil" = '-' ] && sigil='' || sigil='-'
		    else
			[ -n "$secondsDiff" ] && secondsDiff=$((-secondsDiff))
			[ -n "$daysDiff" ] && daysDiff=$((-daysDiff))
		    fi
		    ;;
	*)	    printf >&2 'ASSERT: Unhandled outputSign: %s\n' "$outputSign"; exit 3;;
    esac

    addDiffUnit   "$secondsDiff" s second
    calculateUnit "$secondsDiff" m minute 60
    calculateUnit "$secondsDiff" h hour 3600
    calculateUnit "$secondsDiff" d day 86400
    [ -z "$secondsDiff" ] && calculateUnit "$daysDiff"    d day 1
    calculateUnit "$daysDiff"    w week 7
    calculateUnit "$daysDiff"    mo month 30
    calculateUnit "$daysDiff"    y year 365
    calculateUnit "$daysDiff"    g generation 9131

    case "${outputFormat:-all}" in
	s?(econd?(s)))  printSingleUnit ${sigil}${secondsDiff};;
	m?(inute?(s)))  printCalculated ${sigil}${secondsDiff} 60;;
	h?(our?(s)))    printCalculated ${sigil}${secondsDiff} 3600;;
	d?(ay?(s)))	printSingleUnit ${sigil}${daysDiff};;
	w?(eek?(s)))    printCalculated ${sigil}${daysDiff} 7;;
	mo?(nth?(s)))   printCalculated ${sigil}${daysDiff} 30;;
	y?(ear?(s)))    printCalculated ${sigil}${daysDiff} 365;;
	g?(eneration?(s)))
			printCalculated ${sigil}${daysDiff} 9131;;

	original)	printOriginal "${!#}";;
	epoch)		printOriginal "@$d2";;
	empty)		printOriginal '';;
	whole-units)    # Choose all units that are not just a fraction; i.e. do not start with 0.
			typeset -a wholeUnits=()
			for unit in "${diffInUnits[@]}"
			do
			    [ "${unit:0:1}" = 0 -o "${unit:0:2}" = -0 ] || wholeUnits+=("$unit")
			done
			if [ ${#wholeUnits[@]} -eq 0 ]; then
			    printOne "${diffInUnits[-1]}"
			else
			    joinBy ${prefixAndDirectionPrefix:+--prefix "$prefixAndDirectionPrefix"} ${suffixAndDirectionSuffix:+--suffix "$suffixAndDirectionSuffix"} ' = ' "${wholeUnits[@]}"
			fi
			;;
	smallest-unit)  printOne "${diffInUnits[0]}";;
	largest-unit)   printOne "${diffInUnits[-1]}";;
	best-unit)	# Choose the largest one that is not just a fraction; i.e. does not start with 0.
			for ((i = $((${#diffInUnits[@]} - 1)); i >= 0; i--))
			do
			    best="${diffInUnits[i]}"
			    [ "${best:0:1}" = 0 -o "${best:0:2}" = -0 ] || break
			done
			printOne "$best"
			;;
	precise)	[ -n "$preciseDiff" ] || preciseDiff="$(getPreciseDiff)" || exit $?
			printf '%s%s%s%s\n' "$prefixAndDirectionPrefix" "$preciseDiff" "$suffixAndDirectionSuffix" "$addendum"
			;;
	all)		preciseDiff="$(getPreciseDiff)" || exit $?
			[ -n "$preciseDiff" ] && [[ "$preciseDiff" =~ [\ :] ]] && diffInUnits+=("$preciseDiff")
			joinBy ${prefixAndDirectionPrefix:+--prefix "$prefixAndDirectionPrefix"} ${suffixAndDirectionSuffix:+--suffix "$suffixAndDirectionSuffix"} ' = ' "${diffInUnits[@]}";;

	textform)	preciseDiff="$(getPreciseDiff)" || exit $?
			alternatives=()
			for d in "${diffInUnits[@]}"
			do
			    [ "$d" = "$preciseDiff" ] && preciseDiff=''
			    alternatives+=("${directionPrefix}${d}${directionSuffix}")
			done
			[ -n "$preciseDiff" ] && [[ "$preciseDiff" =~ [\ :] ]] && alternatives+=("${directionPrefix}${preciseDiff}${directionSuffix}")
			[ ${#diffInUnits[@]} -gt 1 ] && alternatives+=("$(joinBy ${directionPrefix:+--prefix "$directionPrefix"} ${directionSuffix:+--suffix "$directionSuffix"} ' = ' "${diffInUnits[@]}")")
			joinBy --prefix "${prefix}[" --suffix "]${suffix}${addendum}" '|' "${alternatives[@]}"
			;;
	*)		printf >&2 'ERROR: Invalid output format: %s\n' "$outputFormat"; exit 2;;
    esac
    return $status
}

overallStatus=
handleNormalStatus()
{
    local exitStatus=${1:?}; shift
    if [ $exitStatus -eq 0 ]; then
	: ${overallStatus:=0}
    elif [ $exitStatus -gt ${overallStatus:-0} ]; then
	overallStatus=$exitStatus
    fi
}

handleFilterStatus()
{
    local exitStatus=${1:?}; shift
    if [ $exitStatus -eq 0 ]; then
	[ ${overallStatus:-1} -eq 1 ] && overallStatus=0
    elif [ $exitStatus -eq 1 ]; then
	: ${overallStatus:=1}
    elif [ $exitStatus -gt ${overallStatus:-1} ]; then
	overallStatus=$exitStatus
    fi
}

diffInput()
{
    local line dateOrTime addendum
    while IFS=$'\n' read -r line || [ -n "$line" ]
    do
	dateOrTime="${line%%"$fieldSeparator"*}"
	addendum="${line#"$dateOrTime"}"
	[ "$outputFormat" = empty ] && addendum="${addendum#"$fieldSeparator"}" # Remove separator when not outputting the date [difference].

	if [ -z "$dateOrTime" ]; then
	    isOutput && printf '%s\n' "$addendum"
	    continue
	fi

	diffOneDate "$@" "$dateOrTime"; $statusHandler $?
    done
    return ${overallStatus:-99}
}

if [ ${#filespecs[@]} -gt 0 ]; then
    if [ "${filespecs[*]}" = '-' ]; then
	diffInput "$@"
    else
	cat -- "${filespecs[@]}" \
	    | diffInput "$@"
	typeset -a states=("${PIPESTATUS[@]}")
	[ ${states[0]} -ne 0 ] && exit 5 || exit ${states[1]}
    fi
else
    diffOneDate "$@"
fi
